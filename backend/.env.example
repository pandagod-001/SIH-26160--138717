# IPsecTrace Backend Configuration
IPSECTRACE_ENV=development
IPSECTRACE_HOST=0.0.0.0
IPSECTRACE_PORT=8000
# Production: PostgreSQL + TimescaleDB (Time-series telemetry & RDBMS)
DATABASE_URL=postgresql://ipsec_admin:secure_password@localhost:5432/ipsectrace
# Local/Testing SQLite fallback:
# DATABASE_URL=sqlite:///./ipsectrace.db
UPLOAD_DIR=./uploads
FLOW_WINDOW_SEC=3.0
MODEL_PATH=./models/xgb_native_ipsec.json
LOG_LEVEL=INFO

